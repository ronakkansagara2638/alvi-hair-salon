# Password for the staff dashboard at /admin
# Change this before the site goes live.
ADMIN_PASSWORD=change-me

# MongoDB connection string. Required on Vercel, where the file system is
# read-only. Leave it blank locally to store bookings in ./data/bookings.json.
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB=alvi-salon

# Optional: where the local JSON file is written (ignored when MONGODB_URI set)
# DATA_DIR=./data
